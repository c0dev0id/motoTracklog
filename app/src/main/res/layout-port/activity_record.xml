<?xml version="1.0" encoding="utf-8"?>
<!-- Portrait: status on top, then one tile grid of four equal rows: live values (or the
     latest run) in the top three, the controls in the bottom one. Same ids as the landscape
     layout. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/background"
    android:padding="@dimen/screen_padding">

    <de.codevoid.mototracklog.ui.TouchOnlyRow
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/header_margin_bottom"
        android:gravity="center_vertical">

        <Button
            android:id="@+id/runsButton"
            style="@style/Widget.MotoTracklog.HeaderButton"
            android:layout_marginStart="0dp"
            android:text="@string/runs" />

        <View
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <Button
            android:id="@+id/settingsButton"
            style="@style/Widget.MotoTracklog.HeaderButton"
            android:text="@string/settings" />
    </de.codevoid.mototracklog.ui.TouchOnlyRow>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:id="@+id/recordContent"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical">

            <include
                android:id="@+id/status"
                layout="@layout/view_record_status" />

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="3">

                <include
                    android:id="@+id/stats"
                    layout="@layout/view_record_stats" />

                <include
                    android:id="@+id/latestRun"
                    layout="@layout/view_latest_run" />
            </FrameLayout>

            <include
                android:id="@+id/actions"
                layout="@layout/view_record_actions"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1" />
        </LinearLayout>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/settingsGrid"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:visibility="gone" />
    </FrameLayout>
</LinearLayout>
