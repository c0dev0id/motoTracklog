<?xml version="1.0" encoding="utf-8"?>
<!-- Filters in a row of tiles, the filtered result in the middle, the share verb at the
     bottom. The same arrangement serves both orientations. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/background"
    android:padding="@dimen/screen_padding">

    <include
        android:id="@+id/header"
        layout="@layout/view_screen_header" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <include
            android:id="@+id/accuracyFilter"
            layout="@layout/item_tile"
            android:layout_width="0dp"
            android:layout_height="@dimen/tile_height"
            android:layout_weight="1"
            android:layout_margin="@dimen/tile_margin" />

        <include
            android:id="@+id/distanceFilter"
            layout="@layout/item_tile"
            android:layout_width="0dp"
            android:layout_height="@dimen/tile_height"
            android:layout_weight="1"
            android:layout_margin="@dimen/tile_margin" />

        <include
            android:id="@+id/timeFilter"
            layout="@layout/item_tile"
            android:layout_width="0dp"
            android:layout_height="@dimen/tile_height"
            android:layout_weight="1"
            android:layout_margin="@dimen/tile_margin" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:gravity="center">

        <TextView
            android:id="@+id/resultValue"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:fontFamily="@font/michroma"
            android:textColor="@color/on_surface"
            android:textSize="@dimen/text_result_value" />

        <TextView
            android:id="@+id/resultDetail"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/status_subtitle_margin_top"
            android:gravity="center"
            android:maxLines="2"
            android:textColor="@color/on_surface_muted"
            android:textSize="@dimen/text_result_detail" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/shareButton"
            style="@style/Widget.MotoTracklog.ActionTile"
            android:focusable="false"
            android:text="@string/share_gpx" />
    </LinearLayout>
</LinearLayout>
