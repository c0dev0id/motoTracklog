<?xml version="1.0" encoding="utf-8"?>
<!-- A display-only tile: a muted label over a value and its unit. Not focusable and not
     clickable, so the remote passes over it and the tile background stays in its rest state. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:background="@drawable/tile_background"
    android:padding="@dimen/stat_tile_padding">

    <TextView
        android:id="@+id/statLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:textColor="@color/on_surface_muted"
        android:textSize="@dimen/text_stat_label" />

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:baselineAligned="true">

        <TextView
            android:id="@+id/statValue"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:fontFamily="@font/michroma"
            android:textColor="@color/on_surface"
            android:textSize="@dimen/text_stat_value" />

        <TextView
            android:id="@+id/statUnit"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/stat_unit_margin_start"
            android:maxLines="1"
            android:textColor="@color/on_surface_muted"
            android:textSize="@dimen/text_stat_unit" />
    </LinearLayout>
</LinearLayout>
